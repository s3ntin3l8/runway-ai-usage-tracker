# --- SYSTEM & OS ---
.DS_Store
Thumbs.db
*.swp
*.bak
*~

# --- PYTHON ---
# The virtualenv names are written without a trailing slash on purpose: git
# matches a trailing-slash rule against directories only, and a symlink to a
# directory is a file to git. CONTRIBUTING.md tells contributors to symlink the
# main checkout's .venv into a worktree, so `.venv/` alone left that symlink
# untracked - a `git add -A` would have committed it.
.venv
.venv-sc
venv
ENV
env
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.python-version

# --- FRONTEND ---
# No trailing slash: a symlinked dependency tree is ignored too - see the
# virtualenv note above.
node_modules
# Generated by `npm run build:css` (Tailwind). CI, Docker, and `make install`
# all rebuild it from input.css; never edit styles.css by hand.
frontend/css/styles.css

# --- IDE & TOOLS ---
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.idea/

# --- PROJECT STATE & DATABASE ---
*.db
*.sqlite
*.jsonl
!tests/fixtures/*.jsonl
data/
sessions/
metrics/
quota.json
external_metrics.json

# --- SECRETS & ENV ---
.env
.env.*
!.env.example
!.env.traefik.example
# Host-specific compose override (auto-merged); template is docker-compose.override.example.yml
docker-compose.override.yml
*.key
*.pem
secrets/
credentials/
# ...but the webapp's Settings → Credentials UI is source code, not secrets.
!webapp/src/**/credentials/
gha-creds-*.json
# .secrets.baseline is intentionally tracked — CI needs it for detect-secrets

# --- AI & TEMP ---
.gemini/
.claude/
.codex/
.anthropic/
.codex
tasks.md
task.md
diagnose.py
docs/internal/
scratch/
app/brain/
.opencode/

# --- SUPERPOWERS ---
.superpowers/
docs/superpowers/

# --- PYINSTALLER ---
# No trailing slash, so a symlinked output tree is ignored too - see the
# virtualenv note above.
build
dist

# --- MISC ---
webapp/e2e/shots/
docs/comparison/
docs/sidecar_implementation.md
.worktrees
artifacts/
*.py,cover

# --- AUDIT ASSETS ---
# Audit reports are committed under docs/audit/; their screenshot evidence
# stays local. It is regenerable (make screenshots-audit) and it is not worth
# the permanent history weight — see docs/audit/README.md.
docs/audit/assets/

# Developer worktrees (one worktree per branch under .wt/ — see AGENTS.md)
.wt/

coverage/

# memray profiling output
memray*.bin

# Browser security test reports
webapp/playwright-report/
webapp/test-results/

# Raw physical validation profiles, registry backups and runtime control files.
/evidence/
landing-shots/
