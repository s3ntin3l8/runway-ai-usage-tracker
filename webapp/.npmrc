; npm's install-script policy is advisory by default: a dependency whose install
; script is not covered by package.json's allowScripts still runs, with a notice.
; strict-allow-scripts turns that into a hard install failure, so a dependency
; that grows an install script fails the install instead of running quietly.
; The policy itself lives in package.json's allowScripts, and the test in
; tests/unit/test_webapp_lockfile.py keeps the two in step with the lockfile.
strict-allow-scripts=true
